# LLM 配置（AI 任务拆解）
# 供应商：doubao（火山方舟） / ollama（本地）
LLM_PROVIDER=ollama

# 火山方舟配置（LLM_PROVIDER=doubao 时使用）
# LLM_API_KEY=your-ark-api-key
# LLM_MODEL=doubao-pro-32k
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Ollama 本地配置（LLM_PROVIDER=ollama 时使用）
# LLM_MODEL=qwen2:7b
# LLM_BASE_URL=http://localhost:11434/v1

# 服务端口
# PORT=3001
